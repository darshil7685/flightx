# CognoDB connection (Bolt over TLS)
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your-password-here

# Server (Render sets PORT automatically — do not hardcode in production)
PORT=4000

# Comma-separated frontend URLs allowed to call this API
# Local:  http://localhost:5173
# Render: https://your-frontend-name.onrender.com
CORS_ORIGIN=http://localhost:5173
